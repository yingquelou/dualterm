<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/term_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：标题 + 模式切换 + 菜单 -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_local"
                style="@style/BarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_local" />

            <Button
                android:id="@+id/btn_container"
                style="@style/BarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_container" />

            <Button
                android:id="@+id/btn_keyboard"
                style="@style/BarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keyboard" />

            <Button
                android:id="@+id/btn_menu"
                style="@style/BarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar_bg_alt"
            android:ellipsize="middle"
            android:singleLine="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <dev.dualterm.term.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 功能键行，内容在代码里生成 -->
        <HorizontalScrollView
            android:id="@+id/key_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar_bg"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/key_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 准备容器时的遮罩 -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/overlay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
