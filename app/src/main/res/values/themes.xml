<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 用 Framework 主题，避免引入 AppCompat 依赖 -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/term_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/bar_bg</item>
    </style>

    <style name="BarButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!--
      容器管理面板的上下文主题。仍然是 Framework 主题（Material 深色），只是给
      面板单独一个 ContextThemeWrapper：面板里的按钮取这一份 colorAccent，
      和 App 主体的 AppTheme 完全隔离，既有 AlertDialog 观感一行不变。
    -->
    <style name="Theme.DualTerm.Sheet" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bar_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <!-- 面板底部的文字按钮：无边框、不占 extra 内边距，方便并排三个。 -->
    <style name="PanelTextButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>

    <style name="KeyButton" parent="android:Widget.Material.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:backgroundTint">@color/key_bg</item>
    </style>
</resources>
