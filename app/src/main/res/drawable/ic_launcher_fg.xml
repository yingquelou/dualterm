<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景：$_ 的 $_ ... 只留 $。

  为什么不是 $_：自适应图标的前景层要落在中间 66dp 的安全圆内（108dp 图层，
  圆周半径 33dp），排成 "$ + 下划线光标" 时要么光标被圆形遮罩切掉一角，要么
  在 48dp 下缩成一小块糊掉的点。单个 $ 能在任何遮罩形状下完整存活，48dp 时
  也仍然认得出是美元符（shell 提示符的惯用记法），和 Termux 的 >_ 一眼区分。

  坐标按 24 单位画、再按 108dp 声明尺寸缩放：改形状时只需要在 24 网格里推。
  安全区换算：24 单位 × 4.5 = 108dp，所以内容必须落在 24 网格中心 (12,12)、
  半径 7.3 的圆内——下面 S 的两端与竖笔的最外侧都在 7.0 以内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- S：两段半圆接成的美元符主体，线宽 2.4（= 10.8dp），圆头圆角 -->
    <path
        android:pathData="M14.8,8.2L10.4,8.2c-1.2,0 -2,0.9 -2,2s0.8,2 2,2h3.2c1.2,0 2,0.9 2,2s-0.8,2 -2,2H8.8"
        android:strokeColor="#FF7CE38B"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- 竖笔：穿过 S，上下各露出一点 -->
    <path
        android:pathData="M12,5.4L12,18.6"
        android:strokeColor="#FF7CE38B"
        android:strokeWidth="2.4"
        android:strokeLineCap="butt"
        android:fillColor="#00000000" />
</vector>
