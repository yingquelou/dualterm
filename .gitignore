# Ignore by default
.*

# Gradle files
build/

# Local configuration file (sdk path, etc)
local.properties
.DS_Store
Thumbs.db

# Log/OS/temp Files
*.log
*.bak
*.orig
*.rej

# Android Studio generated files and folders
captures/
*.aab
*.apk
output-metadata.json

# IDE/toolchain
*.iml
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml
app/bin/

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Fire`ba`se)
google-services.json

# Android Profiling
*.hprof

# ---- 运行时二进制：由 scripts/fetch-runtime.ps1 生成，不入库 ----
# （rootfs 打包 4MB、proot 一组 .so，按 ABI 生成，跟着版本走会让仓库迅速膨胀）
app/src/main/assets/runtime/rootfs-*.pack
app/src/main/jniLibs/

# github
SHA256SUMS
!.github/
