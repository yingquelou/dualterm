# 统一换行：源码与文本一律 LF，Windows 专属脚本保持 CRLF
* text=auto eol=lf

*.java       text eol=lf
*.c          text eol=lf
*.h          text eol=lf
*.xml        text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.pro        text eol=lf

gradlew      text eol=lf
*.bat        text eol=crlf
*.ps1        text eol=crlf

# 二进制：不要做任何换行/编码转换
*.jar  binary
*.so   binary
*.pack binary
*.apk  binary
*.png  binary
